{
  "name": "Spatial Studio Tokens",
  "version": "2.0.0",
  "colors": {
    "background": {
      "void": "#08090c",
      "graphite": "#111318",
      "graphiteRaised": "#181b22"
    },
    "border": {
      "subtle": "rgba(255, 255, 255, 0.08)",
      "medium": "rgba(255, 255, 255, 0.16)",
      "active": "rgba(255, 255, 255, 0.32)"
    },
    "text": {
      "primary": "#f8f9fa",
      "secondary": "#ced4da",
      "muted": "#868e96"
    },
    "accents": {
      "neural": "#5ce1e6",
      "seismic": "#f4a228",
      "digits": "#a3e635",
      "material": "#e2e8f0",
      "brand": "#ffffff",
      "glass": "#94a3b8",
      "motion": "#eab308"
    }
  },
  "spacing": {
    "1": "8px",
    "2": "16px",
    "3": "24px",
    "4": "32px",
    "6": "48px",
    "8": "64px"
  },
  "radii": {
    "control": "6px",
    "surface": "14px"
  },
  "typography": {
    "sans": "-apple-system, BlinkMacSystemFont, 'SF Pro Display', 'SF Pro Text', -ui-sans-serif, system-ui, sans-serif",
    "mono": "'SF Mono', Menlo, Monaco, Consolas, monospace",
    "maxLineLength": "68ch"
  },
  "motion": {
    "spring": "cubic-bezier(0.16, 1, 0.3, 1)",
    "fast": "120ms",
    "standard": "240ms"
  },
  "glass": {
    "backdropFilter": "blur(24px)",
    "background": "rgba(17, 19, 24, 0.75)"
  }
}
